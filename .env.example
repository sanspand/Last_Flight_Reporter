# API Configuration
AIRLABS_API_KEY=your_api_key_here
AIRPORT_ICAO=KDAL
AIRLINES_FILTER=WN,DL
FLIGHTS_LIMIT=10
APP_TIMEZONE=America/Chicago

# Required for /run authentication; use a long random value
RUN_ID=your_run_id_here

# Email Configuration (Brevo API; set EMAIL_ENABLED to True to enable emails)
EMAIL_ENABLED=False
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_SENDER=your_email@gmail.com
EMAIL_SENDER_NAME=Last Flight Bot
EMAIL_RECIPIENT=manager@example.com

# Logging Configuration
LOG_LEVEL=INFO
# Local/Render only; Vercel logs to stdout
LOG_FILE=flights.log
